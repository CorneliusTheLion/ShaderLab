            <specular>
              <color sid="specular">1 1 1 1</color>
            </specular>
            <shininess>
              <float sid="shininess">52</float>
            </shininess>
            <transparent opaque="A_ONE">
              <color>1 1 1 1</color>
            </transparent>
            <index_of_refraction>
              <float sid="index_of_refraction">1</float>
            </index_of_refraction>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
